rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // אדמין: הכל, כולל מחירון וכספים
    function admin() {
      return request.auth != null && request.auth.token.email in ['yakovfi@gmail.com'];
    }
    // משרד (האדמין נחשב גם משרד)
    function office() {
      return admin() || (request.auth != null && request.auth.token.email in ['levchayale@gmail.com']);
    }
    function courier() {
      return request.auth != null && request.auth.token.email in ['rubalgabi@gmail.com'];
    }

    match /parcels/{id} {
      allow read: if office() || courier();
      allow create, delete: if office();
      allow update: if office() || (courier() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'doneAt', 'photo', 'courierNote', 'log']));
    }

    match /settings/msg {
      allow read: if office() || courier();
      allow write: if office();
    }
    match /settings/prices {
      allow read: if office();
      allow write: if admin();
    }

    match /payments/{id} {
      allow read, write: if admin();
    }

    // דף איתור ללקוחות: קריאה של מסמך בודד בלבד (המזהה הוא גיבוב של מספר חבילה וטלפון), ללא רשימה
    match /track/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if office() || courier();
    }
  }
}
